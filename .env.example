REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:kawn-pulse-engine:1.0 (by /u/YOUR_REDDIT_USERNAME)
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_SECONDS=21600
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
CRON_HEARTBEAT_SECRET=
NEWS_RSS_FEEDS=https://news.google.com/rss/search?q={query},https://www.bing.com/news/search?q={query}&format=rss
ENABLE_MOCK_DATA=true
DATABASE_URL=sqlite:///./kawn_pulse.db
AI_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
AI_SUMMARY_MODEL=sshleifer/distilbart-cnn-12-6
MAX_SOURCE_ITEMS_PER_CONNECTOR=35
PULSE_CARDS_PER_TOPIC=20
SCHEDULER_ENABLED=true
SCHEDULER_REFRESH_MINUTES=30
LOG_LEVEL=INFO
